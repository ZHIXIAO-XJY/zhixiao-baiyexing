{
  "name": "scriptbreaker-desktop",
  "version": "1.0.0",
  "description": "ScriptBreaker —— 视频分镜拆解台（桌面版）",
  "main": "electron/main.js",
  "author": "ZHIXIAO-XJY",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zhixiao.scriptbreaker",
    "productName": "ScriptBreaker",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "index.html",
      "assets/**/*",
      "electron/**/*",
      "!assets/config.local.js",
      "!**/*.md",
      "!node_modules/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScriptBreaker"
    }
  }
}
